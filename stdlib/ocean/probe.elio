// probe.elio — ocean_probe: sample the ocean height and normal at up to 64
// world points, for buoyancy and readback. One invocation per point.
//
// Inputs.
//   points[i] = (x, z, unused, unused)           world metres
//   disp0..disp3: the four cascades' post-FFT A buffers (cascade count in
//   probe.cascades, at most 4; unused bindings may hold any buffer and are never
//   read). Each is n * n vec4 in natural order (index z * n + x), where texel
//   (x, z) sits at world offset (x, z) * tile / n and the tile repeats. The
//   contents are what the inverse FFT leaves in buffer A after ocean_evolve,
//   NOT scaled by choppiness: (Dy, Dx, Dz, dDy/dx) in metres (the same buffer
//   fieldA that ocean_assemble reads; the fourth lane is unused here). This
//   kernel applies the choppiness lambda (probe.lambda) to Dx and Dz, as
//   ocean_foam applies it to the B buffers, so the host binds the same buffers
//   it gives ocean_assemble and ocean_foam.
//
// Method. The surface point drawn at world position q came from the rest
// position p with p + D_h(p) = q, where D_h = lambda (Dx, Dz) summed over cascades,
// each sampled bilinearly. The kernel solves for p with two fixed-point steps
// p <- q - D_h(p), then four Newton steps on F(p) = p + D_h(p) - q with the
// Jacobian I + dD_h/dp. The Jacobian is the exact gradient of the bilinear
// interpolant (it is piecewise constant, and a step is skipped when |det| is
// below 1e-6). The height is Dy summed at the final p. The normal comes from
// central differences of that height at q +- (normalStep, 0) and
// q +- (0, normalStep), so each point costs five inversions.
//
// Output: out[i] = (height, normal.x, normal.z, t) with the unit normal
// (-dh/dx, 1, -dh/dz) / |.|, and t the frame time from the uniform.

struct OceanProbeParams {
  count: u32;
  cascades: u32;
  _pad0: u32;
  _pad1: u32;
  n0: u32;
  n1: u32;
  n2: u32;
  n3: u32;
  size0: f32;
  size1: f32;
  size2: f32;
  size3: f32;
  t: f32;
  normalStep: f32;
  lambda: f32;
  _pad3: f32;
}

@group(0) @binding(0) uniform probe: OceanProbeParams;
@group(0) @binding(1) storage read points: []vec4;
@group(0) @binding(2) storage read disp0: []vec4;
@group(0) @binding(3) storage read disp1: []vec4;
@group(0) @binding(4) storage read disp2: []vec4;
@group(0) @binding(5) storage read disp3: []vec4;
@group(0) @binding(6) storage read_write out: []vec4;

@workgroup(64) kernel ocean_probe(gid: global_invocation_id) {
  let i = gid.x;
  if i >= probe.count { return; }
  let pt = points[i];
  let e = probe.normalStep;
  var h0 = 0.0;
  var h1 = 0.0;
  var h2 = 0.0;
  var h3 = 0.0;
  var h4 = 0.0;
  // Target 0 is the point itself; 1 to 4 are the four offsets.
  for (var tg: u32 = 0u; tg < 5u; tg = tg + 1u) {
    var qx = pt.x;
    var qz = pt.y;
    if tg == 1u { qx = qx + e; }
    if tg == 2u { qx = qx - e; }
    if tg == 3u { qz = qz + e; }
    if tg == 4u { qz = qz - e; }
    var px = qx;
    var pz = qz;
    // Iterations 0-1 fixed point, 2-5 Newton, 6 reads the height at the result.
    for (var it: u32 = 0u; it < 7u; it = it + 1u) {
      var sdx = 0.0;
      var sdy = 0.0;
      var sdz = 0.0;
      var gxx = 0.0;
      var gzx = 0.0;
      var gxz = 0.0;
      var gzz = 0.0;
      for (var c: u32 = 0u; c < probe.cascades; c = c + 1u) {
        var nc = probe.n0;
        var lc = probe.size0;
        if c == 1u {
          nc = probe.n1;
          lc = probe.size1;
        }
        if c == 2u {
          nc = probe.n2;
          lc = probe.size2;
        }
        if c == 3u {
          nc = probe.n3;
          lc = probe.size3;
        }
        // Bilinear sample of the periodic n x n tile at (px, pz).
        let u = px / lc;
        let v = pz / lc;
        let fxs = (u - floor(u)) * f32(nc);
        let fzs = (v - floor(v)) * f32(nc);
        let fxf = floor(fxs);
        let fzf = floor(fzs);
        let x0 = min(u32(fxf), nc - 1u);
        let z0 = min(u32(fzf), nc - 1u);
        let rx = fxs - fxf;
        let rz = fzs - fzf;
        let x1 = (x0 + 1u) % nc;
        let z1 = (z0 + 1u) % nc;
        var v00 = vec4(0.0, 0.0, 0.0, 0.0);
        var v10 = vec4(0.0, 0.0, 0.0, 0.0);
        var v01 = vec4(0.0, 0.0, 0.0, 0.0);
        var v11 = vec4(0.0, 0.0, 0.0, 0.0);
        if c == 0u {
          v00 = disp0[z0 * nc + x0];
          v10 = disp0[z0 * nc + x1];
          v01 = disp0[z1 * nc + x0];
          v11 = disp0[z1 * nc + x1];
        }
        if c == 1u {
          v00 = disp1[z0 * nc + x0];
          v10 = disp1[z0 * nc + x1];
          v01 = disp1[z1 * nc + x0];
          v11 = disp1[z1 * nc + x1];
        }
        if c == 2u {
          v00 = disp2[z0 * nc + x0];
          v10 = disp2[z0 * nc + x1];
          v01 = disp2[z1 * nc + x0];
          v11 = disp2[z1 * nc + x1];
        }
        if c == 3u {
          v00 = disp3[z0 * nc + x0];
          v10 = disp3[z0 * nc + x1];
          v01 = disp3[z1 * nc + x0];
          v11 = disp3[z1 * nc + x1];
        }
        let cell = lc / f32(nc);
        let bil = (1.0 - rz) * ((1.0 - rx) * v00 + rx * v10) + rz * ((1.0 - rx) * v01 + rx * v11);
        let gx = ((1.0 - rz) * (v10 - v00) + rz * (v11 - v01)) / cell;
        let gz = ((1.0 - rx) * (v01 - v00) + rx * (v11 - v10)) / cell;
        // Buffer A is (Dy, Dx, Dz, dDy/dx): the horizontal lanes are y and z.
        sdx = sdx + probe.lambda * bil.y;
        sdy = sdy + bil.x;
        sdz = sdz + probe.lambda * bil.z;
        gxx = gxx + probe.lambda * gx.y;
        gzx = gzx + probe.lambda * gx.z;
        gxz = gxz + probe.lambda * gz.y;
        gzz = gzz + probe.lambda * gz.z;
      }
      if it < 2u {
        px = qx - sdx;
        pz = qz - sdz;
      }
      if it >= 2u {
        if it < 6u {
          let fx = px + sdx - qx;
          let fz = pz + sdz - qz;
          let ja = 1.0 + gxx;
          let jb = gxz;
          let jc = gzx;
          let jd = 1.0 + gzz;
          let det = ja * jd - jb * jc;
          if abs(det) >= 0.000001 {
            px = px - (jd * fx - jb * fz) / det;
            pz = pz - (ja * fz - jc * fx) / det;
          }
        }
      }
      if it == 6u {
        if tg == 0u { h0 = sdy; }
        if tg == 1u { h1 = sdy; }
        if tg == 2u { h2 = sdy; }
        if tg == 3u { h3 = sdy; }
        if tg == 4u { h4 = sdy; }
      }
    }
  }
  let dhdx = (h1 - h2) / (2.0 * e);
  let dhdz = (h3 - h4) / (2.0 * e);
  let inv = 1.0 / sqrt(dhdx * dhdx + dhdz * dhdz + 1.0);
  out[i] = vec4(h0, 0.0 - dhdx * inv, 0.0 - dhdz * inv, probe.t);
}
